# ======================================================================
#  Что НЕ попадает в репозиторий.
#
#  Три категории: секреты, данные и то, что генерируется. Правило простое —
#  всё, что нельзя восстановить из кода, но можно восстановить из бэкапа
#  или пересобрать, здесь. Секреты — в первую очередь: коммит с ключом
#  считается утечкой навсегда, потому что переписать историю мало (копии
#  уже у всех, кто клонировал).
# ======================================================================

# --- секреты ----------------------------------------------------------
# .env читают и systemd (EnvironmentFile=), и ручной запуск. Шаблон с
# пустыми полями лежит рядом как .env.example и коммитится намеренно.
.env
.env.*
!.env.example

# Токены, которые пакеты кладут рядом с собой сами.
tennis_parser/.telegraph_token
tennis_parser/.device_uuid

# --- рабочие данные и состояние --------------------------------------
# Ставки, история и журналы обходчика. Это боевые данные конкретной
# установки: чужому они бесполезны, а свои раскрывают, что и когда
# ставилось. Формат виден из кода, который их пишет.
bets_db.json
bets_history.csv
bot_state.json
surface_cache.json
seen_*.json
bethub_*.json
tennisratioall/*.csv
tennisratioall/*.json
tennisratioall/*.jsonl
bball_data/
bball_aliases.json

# --- кэши и блокировки ------------------------------------------------
# Пересоздаются на первом запуске.
.cache/
tennis_parser/.pinnacle_*.json
tennis_parser/.parse.lock

# --- бэкапы, которые делают скрипты -----------------------------------
# fix_settlements.py, flip_moneyline.py и остальные кладут копию рядом
# перед записью. Это снимки боевых данных.
*.bak-*

# --- окружение и артефакты Python -------------------------------------
# venv здесь линуксовый (проект живёт на сервере), на другой машине он
# всё равно не запустится — ставится из requirements.txt.
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- локальные настройки инструментов ---------------------------------
.claude/
.idea/
.vscode/

# Отметка последнего старта обходчика — рантайм, не код.
tennisratioall/.last_startup
