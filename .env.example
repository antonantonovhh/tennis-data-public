# Общий конфиг для обоих ботов. Скопируйте в .env и заполните.
#
#   cp .env.example .env && chmod 600 .env
#
# Файл читают и служба (через EnvironmentFile=), и ручной запуск
# tennisratioall_run.py — поэтому поведение совпадает.
# Кавычки вокруг значений не обязательны; systemd их не снимает, наш
# загрузчик снимает.

# --- основной бот (обязательно, без него bot_merged не импортируется) ---
TELEGRAM_TOKEN=
CHAT_ID=

# --- tennisratioall: ОТДЕЛЬНЫЙ бот, иначе кнопки будут конфликтовать ---
TRA_BOT_TOKEN=
TRA_CHAT_ID=

# --- поведение обхода афиши ---
TRA_MODE=each
TRA_POLL=600
TRA_THROTTLE=5
TRA_SIM_RUNS=5000
TRA_SEND_PACE=3.5

# Через сколько часов после начала матч без результата считается
# несостоявшимся и ставки уходят в возврат. Отменённые матчи TennisExplorer
# не публикует вовсе, отличить отмену от «результат ещё не выложили» можно
# только по времени. Меньше суток ставить не стоит: под возврат попадут
# матчи, чей результат просто не успели выложить.
TRA_ABANDON_HOURS=48

# общий лимит одновременных парсингов на весь сервер (кнопка + обход)
TP_PARSE_CONCURRENCY=1

# Отчёты статьями на telegra.ph. Пока строка закомментирована, ссылка под
# карточкой ведёт на tennisratio, а не на «Полная симуляция».
# Раскомментируйте, если готовы к тому, что страницы публичные: адрес не
# угадать, но у кого ссылка — тот и читает.
# TP_TELEGRAPH=1

# Ключ API Pinnacle. Если check_pinnacle.py показывает 401 — ключ устарел,
# возьмите новый из DevTools (F12 -> Network -> любой запрос к
# guest.api.arcadia.pinnacle.com -> Request Headers -> X-API-Key).
# PIN_API_KEY=

# Прокси ТОЛЬКО для Pinnacle — если API забанил IP сервера.
# Проверить: ./venv/bin/python3 check_pinnacle.py
# PIN_PROXY=http://user:pass@host:port
# PIN_PROXY=socks5://host:port

# Пауза между запросами к Pinnacle, секунды (по умолчанию 20).
# Запросов за круг примерно «матчей x 2 + 1», так что 60 секунд на 17 матчах
# это 35 минут только на кэфы — круг перестанет успевать. Если бан прилетит
# снова, поднимайте до 30, не до 60.
# PIN_MIN_INTERVAL=30

# Веб-панель со статистикой: http://<ip>:8800/?token=...
# Без токена страница не открывается. Задайте свой, иначе он будет
# генерироваться заново при каждом перезапуске.
# DASH_TOKEN=
# DASH_PORT=8800
# DASH_HOST=0.0.0.0     # 127.0.0.1 + SSH-туннель безопаснее

# --- необязательное, если используется в основном боте ---
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ======================================================================
#  Ниже — то, без чего часть функций молча деградирует. Все значения
#  пустые: заполняются на месте, в репозиторий не попадают.
# ======================================================================

# --- Pinnacle: котировки ---------------------------------------------
# Публичный ключ веб-фронтенда Pinnacle. Лежит в JS их сайта, снимается из
# DevTools (вкладка Network, заголовок X-API-Key любого запроса к
# guest.api.arcadia.pinnacle.com). Периодически протухает: признак —
# HTTP 401 на всех запросах разом. Это НЕ бан по IP, с другого адреса
# будет то же самое.
# Раньше значение по умолчанию было зашито в bot_merged.py, из-за чего всё
# работало «само» и без .env. Учётные данные в коде держать нельзя — файл
# уходит в репозиторий вместе с ключом.
PIN_API_KEY=

# Прокси к Pinnacle, если он закрыт из вашей сети.
#   http://user:pass@host:port   или   socks5://host:port
# Для socks5 нужен пакет PySocks, иначе каждый запрос падает с
# InvalidSchema: Missing dependencies for SOCKS support.
PIN_PROXY=

# --- веб-панели -------------------------------------------------------
# Панели открываются только с токеном: http://<ip>:<порт>/?token=...
# Если не задать, токен генерируется на каждый запуск и печатается в лог —
# то есть после рестарта старые ссылки перестают работать.
DASH_TOKEN=

# --- публикация на bet-hub -------------------------------------------
# Подпись запросов: HMAC-SHA256, секрет берётся как ASCII. Подробности и
# эталонный вектор — в test_bethub.py.
BETHUB_API_KEY=
BETHUB_API_SECRET=

# --- отчёты на почту (необязательно) ---------------------------------
# Для Gmail нужен пароль приложения, НЕ пароль от аккаунта.
SENDER_EMAIL=
SENDER_PASSWORD=
RECEIVER_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# --- разбор через внешние модели (необязательно) ---------------------
# Без ключей соответствующие кнопки просто не работают, бот не падает.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- публикация полного отчёта на telegra.ph (необязательно) ---------
TP_TELEGRAPH=0
TP_TELEGRAPH_TOKEN=
